# Copie para ".env" (NUNCA suba o .env para o GitHub) e preencha.
# O jeito fácil: rode  npm run hash-senha  → ele cria o .env com as duas primeiras.

# Hash da senha do admin (scrypt). NÃO é a senha: é gerado por npm run hash-senha
ADMIN_PASSWORD_HASH=

# Chave que assina os tokens de login: texto aleatório com 32+ caracteres
SESSION_SECRET=

# Endereços do front que podem chamar a API (separe por vírgula)
CORS_ORIGIN=http://localhost:5173

# Quanto tempo o login do admin vale, em horas
SESSION_HOURS=8

# Em produção: NODE_ENV=production faz o servidor recusar subir com config insegura
# NODE_ENV=production

# Onde fica o banco SQLite (em produção, aponte para o disco persistente)
# DB_PATH=/var/data/shtech.db

# Libera POST /api/reset em produção (apaga tudo e recarrega o seed)
# ALLOW_RESET=false
